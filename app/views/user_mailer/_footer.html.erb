<!-- Email Footer -->
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #111827; margin: 0; padding: 0;">
  <tr>
    <td align="center" style="padding: 24px 16px;">
      <table border="0" cellpadding="0" cellspacing="0" width="600" style="max-width: 600px; margin: 0 auto;">
        <tr>
          <td align="center" style="padding: 16px 0;">
            <div style="font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif; font-size: 12px; color: #d1d5db; line-height: 18px; text-align: center;">
              <strong style="color: #d2f803;">Uplo</strong> - AI Social Media for Personal Trainers<br>
              <span style="color: #9ca3af;">Helping 500+ fitness professionals grow their business</span>
            </div>
          </td>
        </tr>
        <tr>
          <td align="center" style="padding-top: 16px; border-top: 1px solid #374151;">
            <div style="font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif; font-size: 10px; color: #6b7280; line-height: 14px; text-align: center;">
              You're receiving this because you signed up for Uplo.<br>
              <a href="<%= unsubscribe_url(token: @user.unsubscribe_token) %>" style="color: #6b7280; text-decoration: underline;">Unsubscribe</a>
